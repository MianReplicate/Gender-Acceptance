<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
  <!--    Mod information-->
  <GameVersion>1.6</GameVersion>
  <ModName>Topic of Gender</ModName>

  <!--    Don't change the below!-->
  <OutputType>Library</OutputType>
  <TargetFramework>net48</TargetFramework>
  <LangVersion>12</LangVersion>
  <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  <DebugType>embedded</DebugType>
  <EmbedAllSources>true</EmbedAllSources>
  <OutputPath>../../$(GameVersion)/Assemblies/</OutputPath>
  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

  <!-- System variables using SDK property functions -->
  <IsWindows>$([System.OperatingSystem]::IsWindows())</IsWindows>
  <IsLinux>$([System.OperatingSystem]::IsLinux())</IsLinux>
  <IsMacOS>$([System.OperatingSystem]::IsMacOS())</IsMacOS>
  <CurrentOS Condition="'$(IsMacOS)' == 'True'">MacOS</CurrentOS>
  <CurrentOS Condition="'$(IsLinux)' == 'True'">Linux</CurrentOS>
  <CurrentOS Condition="'$(IsWindows)' == 'True'">Windows</CurrentOS>
  <UserName>$([System.Environment]::UserName)</UserName>
  <UserFolder Condition="'$(CurrentOS)' != 'Windows'">$(HOME)</UserFolder>
  <UserFolder Condition="'$(CurrentOS)' == 'Windows'">$(USERPROFILE)</UserFolder>

  <!--    Some fallbacks for RimWorldPath, but otherwise define this in OS manually for best fit-->
  <RimWorldPath Condition="'$(RimWorldPath)' == '' and '$(IsMacOS)' == 'True'">$(UserFolder)/Library/Application Support/Steam/steamapps/common/RimWorld</RimWorldPath>
  <RimWorldPath Condition="'$(RimWorldPath)' == '' and '$(IsLinux)' == 'True'">$(UserFolder)/.local/share/Steam/steamapps/common/RimWorld</RimWorldPath>
  <RimWorldPath Condition="'$(RimWorldPath)' == '' and '$(IsWindows)' == 'True'">C:/Program Files (x86)/Steam/steamapps/common/RimWorld</RimWorldPath>
  <RimWorldInternal Condition="'$(IsMacOS)' == 'True'">$(RimWorldPath)/RimWorldMac.app</RimWorldInternal>
  <RimWorldInternal Condition="'$(IsMacOS)' == 'False'">$(RimWorldPath)</RimWorldInternal>
</PropertyGroup>

<ItemGroup>
  <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" />
  <PackageReference Include="Lib.Harmony.Ref" Version="2.4.2" />
  <PackageReference Include="RimWorld.MultiplayerAPI" Version="0.6.0" />
</ItemGroup>

  <ItemGroup>
    <!--    Subscribe to the dependencies below-->
    <Reference Include="SimpleTransExpanded">
      <HintPath>$(RimWorldPath)\..\..\workshop\content\294100\3516912373\1.6\Assemblies\Simple-Trans.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="IdentityDysphoria">
      <HintPath>$(RimWorldPath)\..\..\workshop\content\294100\3282023834\1.6\Assemblies\Identity.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GenderWorks">
      <HintPath>$(RimWorldPath)\..\..\workshop\content\294100\3534254491\1.6\Assemblies\LoveyDoveySexWithRosaline.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="WayBetterRomance">
      <HintPath>$(RimWorldPath)\..\..\workshop\content\294100\2877731755\1.6\Assemblies\WayBetterRomance.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="IntimacyLovin">
      <HintPath>$(RimWorldPath)\..\..\workshop\content\294100\3498422643\1.6\Assemblies\LoveyDoveySexWithEuterpe.dll</HintPath>
    <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

<!-- Post-build deployment -->
<Target Name="PostBuild" AfterTargets="PostBuildEvent">
  <Message Text="Username: $(UserName)" Importance="high"/>
  <Message Text="Current Operating System: $(CurrentOS)" Importance="High" />
  <Message Text="Deploying $(ModName) to RimWorld..." Importance="high" />

  <!-- Remove existing mod from RimWorld if it exists -->
  <RemoveDir Directories="$(RimWorldInternal)/Mods/$(ModName)" Condition="Exists('$(RimWorldInternal)/Mods/$(ModName)')" />

  <!-- Define what to copy -->
  <ItemGroup>
    <!-- Source folder (excluding obj and bin) -->
    <SourceFiles Include="$(MSBuildProjectDirectory)/**/*.*"
                 Exclude="$(MSBuildProjectDirectory)/obj/**/*.*;$(MSBuildProjectDirectory)/bin/**/*.*;$(MSBuildProjectDirectory)/.idea/**/*.*;$(MSBuildProjectDirectory)/packages/**/*.*;" />

    <!-- About folder -->
    <AboutFiles Include="$(MSBuildProjectDirectory)/../../About/**/*.*" />

    <!-- Root files -->
    <RootFiles Include="$(MSBuildProjectDirectory)/../../LICENSE" />
    <RootFiles Include="$(MSBuildProjectDirectory)/../../README.md" />
    <RootFiles Include="$(MSBuildProjectDirectory)/../../loadFolders.xml"/>

    <GameVersionFiles Include="$(MSBuildProjectDirectory)/../../$(GameVersion)/**/*.*" />
  </ItemGroup>

  <!-- Copy all defined files -->
  <Copy SourceFiles="@(SourceFiles)" DestinationFiles="@(SourceFiles->'$(RimWorldInternal)/Mods/$(ModName)/Source/%(RecursiveDir)%(Filename)%(Extension)')" />
  <Copy SourceFiles="@(AboutFiles)" DestinationFiles="@(AboutFiles->'$(RimWorldInternal)/Mods/$(ModName)/About/%(RecursiveDir)%(Filename)%(Extension)')" />
  <Copy SourceFiles="@(RootFiles)" DestinationFiles="@(RootFiles->'$(RimWorldInternal)/Mods/$(ModName)/%(Filename)%(Extension)')" />
  <Copy SourceFiles="@(GameVersionFiles)" DestinationFiles="@(GameVersionFiles->'$(RimWorldInternal)/Mods/$(ModName)/$(GameVersion)/%(RecursiveDir)%(Filename)%(Extension)')" />

  <Message Text="$(ModName) deployed successfully to $(RimWorldInternal)/Mods/$(ModName)" Importance="high" />
</Target>
</Project>